# --- required ---------------------------------------------------------------
# MongoDB connection string. MONGODB_URI is accepted as an alias.
DB_URL=mongodb+srv://user:password@cluster.mongodb.net/
# Database holding the platform catalog. Derived collections are written here too.
MONGO_DB_NAME=Click
# The platform's own catalog collection. Read-only: imported from, never written to.
STORIES_COLLECTION=stories

# --- auth (required) ----------------------------------------------------------
# Signing key for access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it a random key is generated per process and every token dies on restart.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=10080
MIN_PASSWORD_LENGTH=8

# --- optional: OpenAI ---------------------------------------------------------
# Without a key the service still runs end to end: embeddings fall back to a
# deterministic hashed bag-of-n-grams, and labels/explanations fall back to
# heuristics. The active backend is always reported by GET /health.
# OPENAI_API_KEY is accepted as an alias.
OPENAI_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# --- optional: Sarvam AI (Indic-language routing + finishing stage) -----------
# When set, generations for the listed languages route to Sarvam instead of OpenAI.
# The same key also powers the finishing stage at the end of POST /copilot/draft
# (runs only after the similarity gate clears a scene): a same-language polish
# pass, optional translation into an Indic language (localize_to), and optional
# TTS narration (narrate=true) via Sarvam's Translate and Bulbul TTS APIs.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-30b
SARVAM_LANGUAGES=hi,ta,te,bn,mr,kn,gu
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_MODEL=bulbul:v2

# --- optional: Databricks batch tier ------------------------------------------
# Not on the online request path. Without these, GET /pipeline/databricks still
# returns a deployable job specification; it just is not submitted anywhere.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace

# Databricks Foundation Model APIs are OpenAI-compatible and included in the
# workspace, so inference costs nothing extra. Set either to "databricks" to use
# them instead of OpenAI. Verified working: gte-large-en (1024-dim embeddings) and
# meta-llama-3-3-70b-instruct (chat + JSON mode).
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai

# --- optional: algorithm knobs ------------------------------------------------
# MMR_LAMBDA=0.75                    # 1.0 = pure relevance, 0.0 = pure diversity
# FRESHNESS_HALF_LIFE_DAYS=30
# SIMILARITY_BLOCK_THRESHOLD=0.88
# SIMILARITY_REVIEW_THRESHOLD=0.72
# CLUSTER_THRESHOLD=0.80
# MIN_CONFIDENT_SAMPLE_SIZE=30       # below this a metric is labelled low-confidence
# UNMET_SEARCH_WEIGHT=3.0            # demand weight of one zero-result search
# CANDIDATE_POOL_SIZE=200
# CORS_ORIGINS=*
ENVIRONMENT=development
